---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';

import { url, KVK_URL, JUSTIS_URL, PHONES } from '../lib/site';

const siteUrl = "https://scamhelp.net";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Contact Us", "item": `${siteUrl}/contact-us/` },
  ],
};
---

<Layout title="Contact ScamHelp" description="Contact ScamHelp for a free, confidential case assessment. Transparent Business Solutions B.V., Kalvermarkt 53, The Hague.">
  <Navbar />
  <main class="bg-[#0a0a0f]">

    <!-- Breadcrumb JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


    <!-- Hero banner -->
    <section class="px-6 text-center" style="padding-top:8rem;padding-bottom:12rem;">
      <div class="max-w-3xl mx-auto">
        <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Get In Touch</span>
        <h1 class="text-white mb-5 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(36px,5vw,60px);font-weight:700;line-height:1.1">
          Contact <span class="text-[#9ACF84]">Us</span>
        </h1>
        <p class="text-white/40 max-w-xl mx-auto reveal" style="font-family:'Inter',sans-serif;font-size:16px;line-height:1.7">
          Have you been a victim of online fraud? Request a free, confidential case assessment. We reply within 48 hours.
        </p>
      </div>
    </section>

    <!-- Contact info: office, hours, email | phone numbers -->
    <section class="pb-10 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="reveal rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden flex flex-col lg:flex-row contact-info">

            <!-- Office, hours, email -->
            <div class="p-6 md:p-8 space-y-6 flex-1">
              <!-- Our office -->
              <div class="flex items-start gap-3">
                <div class="contact-card-icon">
                  <svg class="w-5 h-5 text-[#9ACF84]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="flex flex-col gap-1">
                  <h2 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600">Our office</h2>
                  <p class="text-white/40" style="font-size:13px;line-height:1.6">
                    Transparent Business Solutions B.V. (ScamHelp)<br/>
                    Kalvermarkt 53, 2511 CB The Hague, Netherlands
                  </p>
                  <p class="text-white/40" style="font-size:13px;line-height:1.6">
                    Licensed by the Dutch Ministry of Justice and Security,
                    <a href={JUSTIS_URL} target="_blank" rel="noopener noreferrer" class="text-[#9ACF84] hover:underline">POB 07373</a>
                  </p>
                  <p class="text-white/40" style="font-size:13px;line-height:1.6">
                    <a href={KVK_URL} target="_blank" rel="noopener noreferrer" class="text-[#9ACF84] hover:underline">KvK 78091624</a>
                  </p>
                  <a href="https://www.google.com/maps/place/Kalvermarkt+53,+2511+CB+Den+Haag" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-white/40 hover:text-[#9ACF84] transition-colors" style="font-size:12px">
                    Open in Maps
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
              </div>


              <!-- Opening hours -->
              <div class="flex items-start gap-3">
                <div class="contact-card-icon">
                  <svg class="w-5 h-5 text-[#9ACF84]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="flex flex-col gap-1">
                  <h2 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600">Opening hours</h2>
                  <p class="text-white/40" style="font-size:13px;line-height:1.6">Monday to Friday, 10:00 to 18:00 CET</p>
                </div>
              </div>


              <!-- Email -->
              <div class="flex items-start gap-3">
                <div class="contact-card-icon">
                  <svg class="w-5 h-5 text-[#9ACF84]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="flex flex-col gap-1">
                  <h2 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600">Email</h2>
                  <a href="mailto:support@scamhelp.net" class="text-[#9ACF84] hover:underline" style="font-size:13px">support@scamhelp.net</a>
                </div>
              </div>
            </div>

            <!-- Call us -->
            <div class="p-6 md:p-8 flex-1 border-t lg:border-t-0 lg:border-l border-white/5">
              <div class="flex items-start gap-3">
                <div class="contact-card-icon">
                  <svg class="w-5 h-5 text-[#9ACF84]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="flex flex-col gap-2 flex-1 min-w-0">
                  <h2 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600">Call us</h2>
                  <table class="phone-table">
                    <thead>
                      <tr>
                        <th scope="col">Country</th>
                        <th scope="col">Number</th>
                      </tr>
                    </thead>
                    <tbody>
                      {PHONES.map((p) => (
                        <tr>
                          <th scope="row">{p.country}</th>
                          <td><a href={`tel:${p.tel}`} class="hover:text-[#9ACF84] transition-colors">{p.display}</a></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

        </div>
      </div>
    </section>

    <!-- Send us a message (consultation form) -->
    <section class="pb-20 px-6">
      <div class="max-w-3xl mx-auto reveal" id="consultation">
        <ContactForm />
      </div>
    </section>

    <!-- What happens next -->
    <section class="py-16 px-6 border-t border-white/5">
      <div class="max-w-3xl mx-auto reveal">
        <h2 class="text-white mb-5" style="font-family:'Montserrat',sans-serif;font-size:clamp(24px,3vw,36px);font-weight:600;line-height:1.2">
          What happens <span class="text-[#9ACF84]">next</span>
        </h2>
        <p class="text-white/45 mb-6" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
          We review your enquiry and contact you within 48 hours to arrange a free consultation. If we believe we can help, we send you a written service agreement setting out the scope of work and fees. No payment is taken before you have signed it. See <a href={url('/fees/')} class="text-[#9ACF84] hover:underline">Our Fees</a> for details.
        </p>
        <p class="text-white/45" style="font-family:'Inter',sans-serif;font-size:13px;line-height:1.7">
          Outcomes vary by case and are not guaranteed.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* Reset margins on contact info text */
  .contact-info h2,
  .contact-info p,
  .contact-info a {
    margin: 0;
  }

  .contact-card-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #9ACF84;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .contact-card-icon svg {
    color: #0a0a0f !important;
  }

  /* Phone numbers table */
  .phone-table {
    width: 100%;
    border-collapse: collapse;
  }
  .phone-table th,
  .phone-table td {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.6;
    text-align: left;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .phone-table thead th {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.3);
    border-bottom-color: rgba(255,255,255,0.1);
  }
  .phone-table tbody th {
    font-weight: 400;
    color: rgba(255,255,255,0.3);
    padding-right: 1rem;
  }
  .phone-table td {
    color: rgba(255,255,255,0.4);
    white-space: nowrap;
  }
  .phone-table tbody tr:last-child th,
  .phone-table tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
