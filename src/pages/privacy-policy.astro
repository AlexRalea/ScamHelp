---
import { url, KVK_URL, JUSTIS_URL } from '../lib/site';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ConsultationSection from '../components/ConsultationSection.astro';
import Footer from '../components/Footer.astro';

const siteUrl = "https://scamhelp.net";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": `${siteUrl}/privacy-policy/` },
  ],
};

const collectedData = [
  { when: "You visit the Website", what: "IP address, browser type and version, device type and operating system, pages visited, date and time of your visit, the site that referred you, and data collected through cookies (see section 10)" },
  { when: "You fill in the consultation form or contact us", what: "First and last name, email address, phone number, country of residence, type of scam, amount lost, and anything you tell us about your case" },
  { when: "You become a Client", what: "In addition to the above: your identity details and identity document (for verification), home address, the signed service agreement, payment and invoicing details, and the evidence you provide, such as bank statements, transaction IDs, wallet addresses, screenshots and messages" },
  { when: "We investigate your case", what: "Information about people or entities suspected of involvement in the fraud, such as names, wallet addresses, account details, website domains and publicly available information" },
];

const legalBases = [
  { purpose: "Replying to your enquiry and assessing your case in the free consultation", basis: "Steps taken at your request before entering into a contract; our legitimate interest in answering enquiries" },
  { purpose: "Carrying out the Services, including investigation, tracing and preparing complaints", basis: "Performance of a contract" },
  { purpose: "Verifying your identity and preventing fraud or misuse of our Services", basis: "Legal obligation; legitimate interest" },
  { purpose: "Invoicing, payments and accounting", basis: "Performance of a contract; legal obligation (tax and accounting records)" },
  { purpose: "Investigating people or entities suspected of defrauding you", basis: "Legitimate interest in establishing, exercising or defending your legal claims, as permitted for licensed investigation agencies" },
  { purpose: "Website analytics, security and improvement", basis: "Legitimate interest; consent where required for cookies" },
  { purpose: "Advertising and measuring how our ads perform", basis: "Consent" },
  { purpose: "Newsletters and marketing emails", basis: "Consent, which you can withdraw at any time" },
  { purpose: "Responding to authorities and enforcing our rights", basis: "Legal obligation; legitimate interest" },
];

const retention = [
  { data: "Enquiries and consultations that do not lead to a service agreement", period: "2 years after our last contact" },
  { data: "Client case files, including evidence and reports", period: "5 years after the service agreement ends" },
  { data: "Invoices and financial records", period: "7 years, as required by Dutch tax law" },
  { data: "Marketing consent records", period: "Until you withdraw consent, plus the time needed to prove consent was given" },
  { data: "Website analytics data", period: "As set in our cookie settings, and no longer than 26 months" },
];
---

<Layout title="Privacy Policy, ScamHelp" description="How Transparent Business Solutions B.V. (ScamHelp) collects, uses and protects personal data, and how to exercise your rights." schema={[breadcrumbSchema]}>
  <Navbar />
  <main class="min-h-screen bg-[#0a0a0f] pt-32 pb-20 px-6">
    <article class="max-w-3xl mx-auto">

      <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Legal</span>
      <h1 class="text-white mb-4" style="font-family:'Montserrat',sans-serif;font-size:clamp(30px,4vw,48px);font-weight:700;line-height:1.15">Privacy <span class="text-[#9ACF84]">Policy</span></h1>
      <p class="text-white/40 mb-12" style="font-family:'Inter',sans-serif;font-size:14px">Last updated: November 2026</p>

      <div class="legal-content">

        <h2>1. About this policy</h2>
        <p>This Privacy Policy explains what personal data ScamHelp collects, why we use it, who we share it with and what rights you have. It covers our website <a href="https://scamhelp.net">https://scamhelp.net</a> (the "Website") and our investigation and complaint support services (the "Services").</p>
        <p>ScamHelp is a registered trade name of Transparent Business Solutions B.V., which is the data controller for the personal data described here:</p>
        <p>
          <strong>Transparent Business Solutions B.V.</strong><br />
          Kalvermarkt 53, 2511 CB The Hague, Netherlands<br />
          <a href={KVK_URL} target="_blank" rel="noopener noreferrer">KvK 78091624</a> · Licensed private investigation agency, Dutch Ministry of Justice and Security, <a href={JUSTIS_URL} target="_blank" rel="noopener noreferrer">POB 07373</a><br />
          Data Protection Officer: <a href="mailto:support@scamhelp.net?subject=Data%20Protection">support@scamhelp.net</a> (subject line "Data Protection")
        </p>
        <p>As a licensed private investigation agency, we also follow the Privacy Code of Conduct for the Private Investigation Sector (Privacygedragscode sector particuliere onderzoeksbureaus), which applies to licensed agencies in the Netherlands.</p>

        <h2>2. What we collect</h2>
        <div class="legal-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">What we collect</th>
              </tr>
            </thead>
            <tbody>
              {collectedData.map((row) => (
                <tr>
                  <th scope="row">{row.when}</th>
                  <td>{row.what}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>We do not intentionally collect special categories of personal data, such as health information or religious beliefs. If these appear in material you send us, we only use them where strictly necessary for your case.</p>

        <h2>3. Where your data comes from</h2>
        <p>Most data comes directly from you. Some is collected automatically when you use the Website. We also receive data from third parties: partner organisations that refer people to us with their consent, public sources such as company registers, media and blockchain records, and data providers we use in our investigations.</p>

        <h2>4. How we use your data and our legal basis</h2>
        <div class="legal-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">What we use it for</th>
                <th scope="col">Legal basis</th>
              </tr>
            </thead>
            <tbody>
              {legalBases.map((row) => (
                <tr>
                  <th scope="row">{row.purpose}</th>
                  <td>{row.basis}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>5. Who we share it with</h2>
        <p>We never sell your personal data. We only share it where needed, with:</p>
        <ul>
          <li>service providers working for us, such as hosting, email, customer relationship management, customer support, blockchain analytics, payment processing, website analytics and advertising platforms, under a data processing agreement and only on our instructions;</li>
          <li>banks, exchanges, payment providers, financial ombudsman services, regulators and law enforcement, when we submit complaints or reports for you as part of the Services, on your instruction;</li>
          <li>independent law firms or investigators, if your case is referred to them with your consent;</li>
          <li>authorities, where the law requires us to disclose information; and</li>
          <li>a buyer or successor, if all or part of our business is merged, acquired or sold, under the same protections as this policy.</li>
        </ul>

        <h2>6. Transfers outside the EEA</h2>
        <p>Some of our Personnel and service providers are based outside the European Economic Area. When personal data is transferred outside the EEA, we make sure it stays protected, for example through a European Commission adequacy decision or the European Commission's Standard Contractual Clauses.</p>

        <h2>7. How long we keep it</h2>
        <div class="legal-table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Data</th>
                <th scope="col">How long we keep it</th>
              </tr>
            </thead>
            <tbody>
              {retention.map((row) => (
                <tr>
                  <th scope="row">{row.data}</th>
                  <td>{row.period}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>We may keep data longer where the law requires it or where it is needed to establish, exercise or defend legal claims.</p>

        <h2>8. How we protect it</h2>
        <p>We use appropriate technical and organisational measures to protect personal data against loss, misuse and unauthorised access. These include secure servers, encrypted data transfers, access limited to Personnel who need it for their work, confidentiality obligations for all Personnel and subcontractors, and identity checks before we share information with anyone who asks for it.</p>

        <h2>9. Your rights</h2>
        <p>Under the GDPR, you can:</p>
        <ul>
          <li>ask for a copy of your personal data and information about how we use it;</li>
          <li>have inaccurate or incomplete data corrected;</li>
          <li>have your data deleted where we have no legal reason to keep it;</li>
          <li>restrict how we use your data;</li>
          <li>receive your data in a structured, commonly used format, or have it sent to another organisation;</li>
          <li>object to our use of your data based on legitimate interests, and to direct marketing at any time; and</li>
          <li>withdraw your consent at any time, without affecting what we did before you withdrew it.</li>
        </ul>
        <p>To use any of these rights, email <a href="mailto:support@scamhelp.net?subject=Data%20Protection">support@scamhelp.net</a> with the subject line "Data Protection". We may need to confirm your identity first, and we will reply within one month.</p>
        <p>You can also complain to a data protection authority. In the Netherlands, this is the Autoriteit Persoonsgegevens (<a href="https://autoriteitpersoonsgegevens.nl" target="_blank" rel="noopener noreferrer">https://autoriteitpersoonsgegevens.nl</a>). You may also contact the authority in the country where you live.</p>

        <h2 id="cookies">10. Cookies</h2>
        <p>The Website uses cookies and similar technologies. Strictly necessary cookies keep the Website working and do not need your consent. Analytics and advertising cookies, including Google's, are only used if you agree, and you can change your choice at any time in the <button type="button" data-cookie-settings class="link-button">cookie settings</button> on the Website. You can also block cookies in your browser, although some parts of the Website may then not work properly. See our <a href={url('/cookie-policy/')}>Cookie Policy</a> for details.</p>

        <h2>11. Automated decisions</h2>
        <p>We do not use automated decision-making to decide whether to take on a case or to set the terms of a service agreement.</p>

        <h2>12. Children</h2>
        <p>Our Services are not intended for anyone under 18, and we do not knowingly collect their personal data. If you believe we hold data about someone under 18, contact <a href="mailto:support@scamhelp.net">support@scamhelp.net</a> and we will delete it where required.</p>

        <h2>13. Changes to this policy</h2>
        <p>We may update this Privacy Policy from time to time. The current version is always on the Website, with the date of the last update at the top. If we make significant changes, we will inform our Clients directly.</p>

        <h2>14. Contact</h2>
        <p>For questions about this Privacy Policy or your personal data, email <a href="mailto:support@scamhelp.net">support@scamhelp.net</a> or use our <a href={url('/contact-us/')}>contact page</a>.</p>

      </div>

      <div class="mt-16">
        <a href={url('/')} class="text-[#9ACF84] hover:underline" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;">← Back to Home</a>
      </div>

    </article>
  </main>
  <ConsultationSection />
  <Footer />
</Layout>

<style>
  .legal-content h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: white;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .legal-content p {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1rem;
  }
  .legal-content ul, .legal-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .legal-content ul { list-style: disc; }
  .legal-content ol { list-style: decimal; }
  .legal-content li {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    margin-bottom: 0.5rem;
  }
  .legal-content a,
  .legal-content .link-button {
    color: #9ACF84;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content a:hover,
  .legal-content .link-button:hover {
    color: #b5e0a0;
  }
  .legal-content .link-button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .legal-content strong {
    color: rgba(255,255,255,0.7);
  }
  .legal-table-wrap {
    overflow-x: auto;
    margin-bottom: 1rem;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.625rem;
  }
  .legal-content table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }
  .legal-content thead th {
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: white;
    text-align: left;
    background: rgba(154,207,132,0.08);
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .legal-content tbody th,
  .legal-content tbody td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: rgba(255,255,255,0.5);
  }
  .legal-content tbody th {
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    width: 40%;
  }
  .legal-content tbody tr:last-child th,
  .legal-content tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
