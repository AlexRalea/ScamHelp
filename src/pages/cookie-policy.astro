---
import { url } from '../lib/site';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ConsultationSection from '../components/ConsultationSection.astro';
import Footer from '../components/Footer.astro';

const cookies = [
  {
    name: 'sh_consent',
    provider: 'ScamHelp',
    purpose: 'Stores your cookie choice so it can be respected on every page. Kept in your browser\'s local storage, not as a cookie.',
    duration: 'Until you clear it or change your choice',
    category: 'Strictly necessary',
  },
  {
    name: '_ga',
    provider: 'Google Analytics (via Google Tag Manager)',
    purpose: 'Distinguishes visitors.',
    duration: '2 years',
    category: 'Analytics (only with consent)',
  },
  {
    name: '_ga_<container-id>',
    provider: 'Google Analytics (via Google Tag Manager)',
    purpose: 'Keeps session state.',
    duration: '2 years',
    category: 'Analytics (only with consent)',
  },
  {
    name: '_gcl_au',
    provider: 'Google Ads (via Google Tag Manager)',
    purpose: 'Measures ad conversions.',
    duration: '90 days',
    category: 'Advertising (only with consent)',
  },
];
---

<Layout title="Cookie Policy, ScamHelp" description="Which cookies the ScamHelp website uses, why, and how to manage your consent.">
  <Navbar />
  <main class="min-h-screen bg-[#0a0a0f] pt-32 pb-20 px-6">
    <article class="max-w-3xl mx-auto">

      <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Legal</span>
      <h1 class="text-white mb-4" style="font-family:'Montserrat',sans-serif;font-size:clamp(30px,4vw,48px);font-weight:700;line-height:1.15">Cookie <span class="text-[#9ACF84]">Policy</span></h1>
      <p class="text-white/40 mb-12" style="font-family:'Inter',sans-serif;font-size:13px">Last updated: November 2026</p>

      <div class="legal-content">

        <h2>About this cookie policy</h2>
        <p>This Cookie Policy explains which cookies and similar technologies the ScamHelp website (scamhelp.net) uses, why we use them, and how you can manage your consent. ScamHelp is a registered trade name of Transparent Business Solutions B.V., which is the data controller for personal data collected through the website. For more on how we process personal data, see our <a href={url('/privacy-policy/')}>Privacy Policy</a>.</p>

        <h2>What are cookies?</h2>
        <p>Cookies are small text files that a website stores on your device when you visit it. Similar technologies, such as your browser's local storage, work in a comparable way. Cookies can be set by the website itself or by a third-party service used on the website.</p>

        <h2>How we use cookies</h2>
        <p><strong>Strictly necessary:</strong> we store your consent choice in your browser's local storage under the key <code>sh_consent</code>, so that we can respect it on every page. This is not a cookie, and it is kept until you clear it or change your choice. No other strictly necessary cookies are set by the website.</p>
        <p><strong>Analytics (only with your consent):</strong> Google Analytics, loaded through Google Tag Manager, helps us understand how visitors use the website.</p>
        <p><strong>Advertising (only with your consent):</strong> Google Ads, loaded through Google Tag Manager, measures ad conversions.</p>

        <h2>Google Consent Mode v2</h2>
        <p>We use Google Consent Mode v2. Until you accept, analytics and advertising storage is denied and Google Tag Manager is not loaded, so no analytics or advertising cookies are set. If you accept only one of these categories, the other remains denied.</p>

        <h2>Cookies we use</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Provider</th>
                <th scope="col">Purpose</th>
                <th scope="col">Duration</th>
                <th scope="col">Category</th>
              </tr>
            </thead>
            <tbody>
              {cookies.map((c) => (
                <tr>
                  <td><code>{c.name}</code></td>
                  <td>{c.provider}</td>
                  <td>{c.purpose}</td>
                  <td>{c.duration}</td>
                  <td>{c.category}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2>How to manage your consent</h2>
        <p>You can change or withdraw your consent at any time via "Cookie settings" at the bottom of every page, or here: <button type="button" data-cookie-settings class="cookie-settings-link">Cookie settings</button>. Withdrawing your consent does not affect what happened before you withdrew it.</p>
        <p>You can also block cookies in your browser, although some parts of the website may then not work properly. Most browsers also let you delete cookies that are already stored on your device.</p>

        <h2>Changes to this policy</h2>
        <p>We may update this Cookie Policy, for example when we add or remove cookies. The date of the last update is shown at the top of this page.</p>

        <h2>Contact</h2>
        <p>The data controller is Transparent Business Solutions B.V. (ScamHelp), Kalvermarkt 53, 2511 CB The Hague, Netherlands. For questions about this Cookie Policy, email <a href="mailto:support@scamhelp.net">support@scamhelp.net</a>. Our <a href={url('/privacy-policy/')}>Privacy Policy</a> explains how we process personal data and how you can exercise your rights.</p>

      </div>

      <div class="mt-16">
        <a href={url('/')} class="text-[#9ACF84] hover:underline" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;">← Back to Home</a>
      </div>

    </article>
  </main>
  <ConsultationSection />
  <Footer />
</Layout>

<style>
  .legal-content h2 {
    font-family: 'Montserrat', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: white;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .legal-content p {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    margin-bottom: 1rem;
  }
  .legal-content ul, .legal-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }
  .legal-content ul { list-style: disc; }
  .legal-content ol { list-style: decimal; }
  .legal-content li {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255,255,255,0.5);
    margin-bottom: 0.5rem;
  }
  .legal-content a,
  .legal-content .cookie-settings-link {
    color: #9ACF84;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content a:hover,
  .legal-content .cookie-settings-link:hover {
    color: #b5e0a0;
  }
  .legal-content .cookie-settings-link {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .legal-content strong {
    color: rgba(255,255,255,0.7);
  }
  .legal-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    color: rgba(255,255,255,0.7);
    white-space: nowrap;
  }
  .legal-content .table-wrap {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
  }
  .legal-content table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
  }
  .legal-content th {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    text-align: left;
    vertical-align: bottom;
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .legal-content td {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255,255,255,0.4);
    vertical-align: top;
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
</style>
