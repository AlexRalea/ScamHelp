---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import { BASE as base, url } from '../lib/site';

const siteUrl = "https://scamhelp.net";
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "News" },
  ],
};
---

<Layout
  title="Fraud News and Scam Alerts, ScamHelp"
  description="News, scam alerts and fraud-prevention tips from the investigators at ScamHelp, a licensed Dutch private investigation agency."
>
  <Navbar />
  <main class="min-h-[70vh] bg-[#0a0a0f] flex flex-col px-6 pt-32 pb-16">

    <!-- Breadcrumb JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


    <div class="text-center flex-1 flex flex-col items-center justify-center">
      <span style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600;letter-spacing:0.2em;color:#9ACF84;">COMING SOON</span>
      <h1 style="font-family:'Montserrat',sans-serif;font-size:clamp(36px,6vw,72px);font-weight:700;color:#ffffff;margin:16px 0 12px;">News</h1>
      <p style="font-family:'Inter',sans-serif;font-size:16px;color:rgba(255,255,255,0.4);margin-bottom:32px;">This page is under construction.</p>
      <a href={url('/')} style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;background:#9ACF84;color:#0a0a0f;padding:12px 28px;border-radius:10px;text-decoration:none;">← Back to Home</a>
    </div>
  </main>
  <Footer />
</Layout>
