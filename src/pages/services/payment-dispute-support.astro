---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ConsultationSection from '../../components/ConsultationSection.astro';
import Footer from '../../components/Footer.astro';
import InfoBlock from '../../components/InfoBlock.astro';
import OutcomesNote from '../../components/OutcomesNote.astro';

import { BASE as base, url } from '../../lib/site';

const services = [
  {
    title: "Chargeback and recall preparation",
    description: "We prepare card chargeback and wire recall requests with the transaction records and evidence your bank or card issuer needs to review them.",
    icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z",
  },
  {
    title: "Fraud case documentation",
    description: "We document how the scam worked, who was paid and when, so your case can be presented clearly to banks and authorities. We can also prepare a report for you to submit to the police.",
    icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  },
  {
    title: "Bank fraud investigation",
    description: "We examine bank fraud cases and the associated transactions to establish how funds moved and which institutions were involved.",
    icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
  },
  {
    title: "Transaction tracing",
    description: "Where funds moved onward, including into cryptocurrency, we trace the transactions to identify where they went.",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Complaints to banks and ombudsman services",
    description: "With your approval, we prepare formal complaints to banks, card issuers and financial ombudsman services, drawing on our experience presenting cases to these institutions.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z",
  },
  {
    title: "Ongoing Support and Updates",
    description: "We believe in transparent communication. Throughout the process, you'll receive regular updates and have continuous access to our team for any questions.",
    icon: "M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z",
  },
];

const faqs = [
  {
    question: "How do you assess my case?",
    answer: "We start with a detailed assessment of your case, examining the nature of the scam, the amount lost, transaction details, and communication records.",
  },
  {
    question: "What types of scams can ScamHelp assist with?",
    answer: "Our payment dispute support covers a wide range of scenarios including online investment frauds, cryptocurrency scams, credit card fraud, phishing attacks, and more.",
  },
  {
    question: "What should I provide for my initial consultation?",
    answer: "You may prepare any relevant documents and evidence, such as transaction records, correspondence with the scammer, screenshots of interactions.",
  },
  {
    question: "Is there a fee for the initial consultation?",
    answer: "We offer a free initial consultation to discuss the specifics of your case and provide initial guidance. If you decide to proceed, fees are set out in a written agreement before any work begins. See Our Fees.",
  },
  {
    question: "Do you publish a success rate?",
    answer: "We do not publish a success rate, because outcomes depend on factors outside our control, such as the bank or exchange involved, the jurisdiction and the age of the case. At the consultation, we give you an honest view of your case.",
  },
  {
    question: "How long does the process take?",
    answer: "The timeline can vary significantly depending on the complexity of the case, the jurisdiction involved, and the responsiveness of financial institutions. Cases can take anywhere from a few weeks to several months.",
  },
  {
    question: "What sets ScamHelp apart?",
    answer: "We are a licensed Dutch private investigation agency. Our licence and company registration are publicly verifiable, our fees are published and agreed in writing before any work begins, and we never ask for fees to release recovered funds.",
  },
];

// FAQ answers ending in "See Our Fees." get a link to the fees page.
const FEES_REF = "See Our Fees.";

const siteUrl = "https://scamhelp.net";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": `${siteUrl}/services/`,
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Payment Dispute Support",
      "item": `${siteUrl}/services/payment-dispute-support/`,
    },
  ],
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Payment Dispute Support",
  "url": `${siteUrl}/services/payment-dispute-support/`,
  "provider": {
    "@type": "Organization",
    "name": "ScamHelp",
    "url": `${siteUrl}/`,
  },
  "description": "ScamHelp helps victims of online fraud and unauthorised transactions prepare chargeback, recall and complaint cases for their bank or card issuer.",
  "areaServed": "Worldwide",
  "serviceType": "Payment Dispute Support",
};
---

<Layout
  title="Payment Dispute Support for Fraud Victims, ScamHelp"
  description="ScamHelp helps victims of online fraud and unauthorised transactions prepare chargeback, recall and complaint cases for their bank or card issuer. Free case assessment."
>
  <Navbar />
  <main>

    <!-- JSON-LD Schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

    <!-- ═══════════ 1. HERO (dark) ═══════════ -->
    <section class="bg-[#0a0a0f] px-6 text-center" style="padding-top:10rem;padding-bottom:5rem;">
      <div class="max-w-3xl mx-auto">
        <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Payment Dispute Support</span>
        <h1 class="text-white mb-5 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(36px,5vw,60px);font-weight:700;line-height:1.1">
          Payment <span class="text-[#9ACF84]">Dispute Support</span>
        </h1>
        <p class="text-white/40 max-w-xl mx-auto reveal" style="font-family:'Inter',sans-serif;font-size:16px;line-height:1.7">
          We help victims of online fraud and unauthorised transactions prepare dispute and complaint cases for their bank or card issuer, with the evidence those institutions require.
        </p>
      </div>
    </section>

    <!-- ═══════════ 2. SERVICES GRID (white) ═══════════ -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#9ACF84]/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">What We Offer</span>
          <h2 class="text-[#0a0a0f] mb-4" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            What this service <span class="text-[#9ACF84]">covers</span>
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {services.map((service, i) => (
            <div class={`card-expandable reveal delay-${i + 1} group p-7 rounded-2xl border border-[#e8e8e8] bg-white hover:border-[#9ACF84]/30 hover:shadow-lg transition-all duration-300`}>
              <div class="flex items-center gap-3 mb-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#9ACF84] flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#0a0a0f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
                  </svg>
                </div>
                <h3 class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:16px;font-weight:600">{service.title}</h3>
              </div>
              <p class="card-desc text-[#0a0a0f]/50" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">{service.description}</p>
            </div>
          ))}
        </div>

        <!-- What you receive + Fees + outcomes (dark text on this white section) -->
        <div class="mt-10 space-y-4 reveal [&_.info-block_p]:text-[#0a0a0f]/70 [&_.outcomes-note]:text-[#0a0a0f]/50">
          <InfoBlock label="What you receive">
            a review of your payments and the dispute options that apply; prepared chargeback, recall or complaint files with supporting evidence; and regular updates on every response.
          </InfoBlock>
          <InfoBlock label="Fees">
            Investigation fees start from €1,500 and are agreed in writing before any work begins. See <a href={url('/fees/')} class="text-[#6BA055] underline underline-offset-2 hover:text-[#9ACF84] transition-colors">Our Fees</a>.
          </InfoBlock>
          <OutcomesNote class="px-5" />
        </div>
      </div>
    </section>

    <!-- ═══════════ 3. ABOUT / LOGO (dark) ═══════════ -->
    <section class="py-12 md:py-16 px-6 bg-[#0a0a0f]">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">

        <!-- Text -->
        <div>
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-4 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">About Us</span>
          <h2 class="text-white mb-6" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            About Scam<span class="text-[#9ACF84]">Help</span>
          </h2>
          <p class="text-white/45 mb-8" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
            ScamHelp is a registered trade name of Transparent Business Solutions B.V., a private investigation agency based in The Hague and licensed by the Dutch Ministry of Justice and Security (licence POB 07373, KvK 78091624). Our team of fraud investigators, financial forensic analysts and case managers works on online investment, cryptocurrency and banking fraud.
          </p>
          <a href={url('/about/')} class="inline-flex items-center gap-2 px-6 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600">
            Learn More
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Image -->
        <div class="reveal from-right rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden" style="aspect-ratio: 1200 / 792;">
          <img src={`${base}/who_we_are_image.webp`} alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>

      </div>
    </section>

    <!-- ═══════════ 4. HOW CAN WE HELP (white) ═══════════ -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#9ACF84]/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">

        <!-- Image -->
        <div class="reveal rounded-2xl border border-[#e8e8e8] bg-[#f8f8f8] overflow-hidden" style="aspect-ratio: 1200 / 788;">
          <img src={`${base}/why_us_image.webp`} alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>

        <!-- Text -->
        <div>
          <h2 class="text-[#0a0a0f] mb-6 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            How we work on <span class="text-[#9ACF84]">your case</span>
          </h2>
          <p class="text-[#0a0a0f]/60 mb-6" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
            We combine financial investigation and blockchain tracing with experience of how banks and card issuers handle disputes. You receive regular updates at every stage.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#0a0a0f]/60" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">Timely communication</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#0a0a0f]/60" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">Experienced investigators</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#0a0a0f]/60" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">Written agreement and clear fees</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#0a0a0f]/60" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">Licensed and publicly verifiable</span>
            </li>
          </ul>
          <a href="#consultation" class="inline-flex items-center gap-2 px-6 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600">
            Free Consultation
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

      </div>
    </section>

    <!-- ═══════════ 5. CTA BANNER (dark) ═══════════ -->
    <section class="py-12 md:py-16 px-6 bg-[#0a0a0f]">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-white mb-5 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
          Not sure what your <span class="text-[#9ACF84]">options are?</span>
        </h2>
        <p class="text-white/40 max-w-xl mx-auto mb-8" style="font-family:'Inter',sans-serif;font-size:16px;line-height:1.7">
          Book a free, confidential case assessment. We'll tell you honestly whether we believe we can help.
        </p>
        <a href={url('/contact-us/')} class="inline-flex items-center gap-2 px-6 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600">
          Contact Us
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </section>

    <!-- ═══════════ 6. FAQ (white) ═══════════ -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#9ACF84]/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">FAQ</span>
          <h2 class="text-[#0a0a0f] mb-4" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            Frequently Asked <span class="text-[#9ACF84]">Questions</span>
          </h2>
        </div>

        <div class="space-y-2">
          {faqs.map((faq, i) => (
            <div class={`faq-item reveal delay-${Math.min(i + 1, 6)} border border-[#e8e8e8] rounded-2xl overflow-hidden transition-all duration-300`}>
              <button class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 text-left hover:bg-[#f8f8f8] transition-colors duration-200" type="button" aria-expanded="false">
                <span class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;line-height:1.4">{faq.question}</span>
                <span class="faq-icon flex-shrink-0 w-7 h-7 rounded-full bg-[#f0f0f0] flex items-center justify-center transition-all duration-300">
                  <svg class="w-3.5 h-3.5 text-[#555] transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>
              <div class="faq-body" style="max-height:0;overflow:hidden;transition:max-height 0.35s ease, padding 0.35s ease;">
                <p class="px-6 pb-5 text-[#777]" style="font-size:14px;line-height:1.75">
                  {faq.answer.endsWith(FEES_REF)
                    ? <>{faq.answer.slice(0, -FEES_REF.length)}See <a href={url('/fees/')} class="text-[#6BA055] underline underline-offset-2 hover:text-[#9ACF84] transition-colors">Our Fees</a>.</>
                    : faq.answer}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════ 7. CONSULTATION ═══════════ -->
    <ConsultationSection />

  </main>
  <Footer />
</Layout>

<script>
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item   = trigger.closest('.faq-item') as HTMLElement;
      const body   = item.querySelector('.faq-body')   as HTMLElement;
      const icon   = item.querySelector('.faq-icon')   as HTMLElement;
      const svg    = icon.querySelector('svg')          as SVGElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.faq-item').forEach((other) => {
        if (other !== item) {
          (other.querySelector('.faq-body') as HTMLElement).style.maxHeight = '0';
          other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
          (other.querySelector('.faq-icon') as HTMLElement).style.background = '#f0f0f0';
          (other.querySelector('.faq-icon svg') as SVGElement)?.style.setProperty('transform', 'rotate(0deg)');
          (other.querySelector('.faq-icon svg') as SVGElement)?.style.setProperty('color', '#555');
          (other as HTMLElement).style.borderColor = '#e8e8e8';
        }
      });

      if (isOpen) {
        body.style.maxHeight = '0';
        trigger.setAttribute('aria-expanded', 'false');
        icon.style.background = '#f0f0f0';
        svg.style.transform = 'rotate(0deg)';
        svg.style.color = '#555';
        item.style.borderColor = '#e8e8e8';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        trigger.setAttribute('aria-expanded', 'true');
        icon.style.background = '#9ACF84';
        svg.style.transform = 'rotate(180deg)';
        svg.style.color = '#0a0a0f';
        item.style.borderColor = 'rgba(154,207,132,0.4)';
      }
    });
  });
</script>
