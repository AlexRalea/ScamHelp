---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ConsultationSection from '../../components/ConsultationSection.astro';
import Footer from '../../components/Footer.astro';
import InfoBlock from '../../components/InfoBlock.astro';
import OutcomesNote from '../../components/OutcomesNote.astro';

import { BASE as base, url } from '../../lib/site';
const siteUrl = "https://scamhelp.net";

const services = [
  {
    title: "Case Assessment and Consultation",
    description: "We begin with a thorough assessment of your case to understand the nature and scope of the dispute. Our experts provide a detailed consultation to outline the options that apply to your specific situation.",
    iconPath: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
  },
  {
    title: "Evidence Collection and Analysis",
    description: "Gathering and analyzing evidence is crucial to any complaint. Our team works diligently to collect all necessary documentation, communications, and other relevant evidence to build a strong case on your behalf.",
    iconPath: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z",
  },
  {
    title: "Complaints to institutions and regulators",
    description: "We prepare formal complaints to banks, card issuers, exchanges, ombudsman services and regulators, with the evidence they require.",
    iconPath: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Follow-up and correspondence",
    description: "With your approval, we handle follow-up correspondence with the institution and keep you informed of every response.",
    iconPath: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  },
  {
    title: "Referral to independent law firms",
    description: "ScamHelp does not provide legal services. Where legal action is needed, we can refer you to an independent law firm. Legal fees are agreed directly with that firm.",
    iconPath: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
];

const faqs = [
  { question: "What is complaint and escalation support?", answer: "It helps fraud victims raise formal disputes and complaints with the banks, card issuers, exchanges and ombudsman services involved in their case, with properly documented evidence." },
  { question: "Is complaint support guaranteed to recover my money?", answer: "While dispute resolution services strive to achieve the best possible outcome, they cannot guarantee the recovery of lost money. The success of the process depends on various factors, including the nature of the scam, the cooperation of the involved parties, and the availability of evidence." },
  { question: "How much does complaint support cost?", answer: "Complaint and escalation services are quoted separately, typically from €1,500 to €15,000, and only carried out with your written approval. See Our Fees." },
  { question: "How long does the process take?", answer: "The duration can vary widely. Some cases may be resolved within a few weeks, while more complex cases can take several months. The timeline depends on factors such as the responsiveness of the parties involved, the availability of evidence, and the negotiation process." },
  { question: "Is my case confidential?", answer: "Yes. Everything you share with us is kept confidential and used only to work on your case, as set out in our Privacy Policy and Terms and Conditions." },
];

// FAQ answers ending in "See Our Fees." get a link to the fees page.
const FEES_REF = "See Our Fees.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": `${siteUrl}/services/` },
    { "@type": "ListItem", "position": 3, "name": "Complaint and Escalation Support", "item": `${siteUrl}/services/complaint-support/` },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Complaint and Escalation Support",
  "description": "ScamHelp prepares and follows up formal complaints to banks, exchanges, ombudsman services and regulators for fraud victims.",
  "url": `${siteUrl}/services/complaint-support/`,
  "provider": { "@type": "Organization", "name": "ScamHelp", "url": `${siteUrl}/` },
  "areaServed": "Worldwide",
  "serviceType": "Complaint and Escalation Support",
};
---

<Layout
  title="Complaint and Escalation Support, ScamHelp"
  description="ScamHelp prepares and follows up formal complaints to banks, exchanges, ombudsman services and regulators for fraud victims. Free case assessment."
>
  <Navbar />
  <main class="bg-[#0a0a0f]">

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />


    <!-- ─── HERO ─── -->
    <section class="px-6 text-center relative overflow-hidden" style="padding-top:8rem;padding-bottom:12rem;">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#9ACF84]/4 rounded-full blur-[200px] pointer-events-none"></div>
      <div class="max-w-3xl mx-auto relative z-10">
        <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Complaint Support</span>
        <h1 class="text-white mb-5 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(36px,5vw,60px);font-weight:700;line-height:1.1">
          Complaint and <span class="text-[#9ACF84]">Escalation Support</span>
        </h1>
        <p class="text-white/40 max-w-xl mx-auto reveal" style="font-family:'Inter',sans-serif;font-size:16px;line-height:1.7">
          Formal complaints to banks, exchanges, financial ombudsman services and regulators, prepared and followed up with your approval.
        </p>
      </div>
    </section>


    <!-- ─── SERVICES GRID ─── -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#9ACF84]/5 rounded-full blur-[150px] pointer-events-none"></div>
      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">What To Expect</span>
          <h2 class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            What this service <span class="text-[#9ACF84]">covers</span>
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {services.map((s, i) => (
            <div class={`card-expandable group p-7 rounded-2xl border border-[#e8e8e8] bg-white hover:border-[#9ACF84]/30 hover:shadow-lg transition-all duration-300 reveal delay-${Math.min(i + 1, 6)}`}>
              <div class="flex items-center gap-3 mb-3">
                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#9ACF84] flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#0a0a0f]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.iconPath} />
                  </svg>
                </div>
                <h3 class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:16px;font-weight:600">{s.title}</h3>
              </div>
              <p class="card-desc text-[#0a0a0f]/50" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.75">{s.description}</p>
            </div>
          ))}
        </div>

        <!-- What you receive + Fees + outcomes (dark text on this white section) -->
        <div class="mt-10 space-y-4 reveal [&_.info-block_p]:text-[#0a0a0f]/70 [&_.outcomes-note]:text-[#0a0a0f]/50">
          <InfoBlock label="What you receive">
            formal complaint files with supporting evidence, submitted with your approval to the banks, exchanges, ombudsman services or regulators involved, plus follow-up and regular updates on every response.
          </InfoBlock>
          <InfoBlock label="Fees">
            Complaint and escalation services are quoted separately, typically from €1,500 to €15,000, and only carried out with your written approval. See <a href={url('/fees/')} class="text-[#6BA055] underline underline-offset-2 hover:text-[#9ACF84] transition-colors">Our Fees</a>.
          </InfoBlock>
          <OutcomesNote class="px-5" />
        </div>
      </div>
    </section>


    <!-- ─── ABOUT SECTION ─── -->
    <section class="py-12 md:py-16 px-6 relative overflow-hidden">
      <div class="absolute right-0 top-1/4 w-[400px] h-[400px] bg-[#9ACF84]/3 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div>
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">About Us</span>
          <h2 class="text-white mb-6" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            About Scam<span class="text-[#9ACF84]">Help</span>
          </h2>
          <p class="text-white/45 mb-8" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
            ScamHelp is a registered trade name of Transparent Business Solutions B.V., a private investigation agency based in The Hague and licensed by the Dutch Ministry of Justice and Security (licence POB 07373, KvK 78091624). Our case managers prepare and follow up complaints for victims of online investment, cryptocurrency and banking fraud.
          </p>
          <a href={url('/about/')} class="inline-flex items-center gap-2 px-6 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600">
            Learn More
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <!-- Image -->
        <div class="reveal from-right rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden" style="aspect-ratio: 1200 / 792;">
          <img src={`${base}/who_we_are_image.webp`} alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>


    <!-- ─── HOW DOES IT WORK ─── -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute left-0 top-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-[#9ACF84]/5 rounded-full blur-[160px] pointer-events-none"></div>
      <div class="relative z-10 max-w-7xl mx-auto grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <!-- Image -->
        <div class="reveal from-left rounded-2xl border border-[#e8e8e8] bg-[#f8f8f8] overflow-hidden" style="aspect-ratio: 1200 / 788;">
          <img src={`${base}/why_us_image.webp`} alt="" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <!-- Text -->
        <div>
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block reveal" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">Our Process</span>
          <h2 class="text-[#0a0a0f] mb-6" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            How our <span class="text-[#9ACF84]">complaint support</span> works
          </h2>
          <p class="text-[#0a0a0f]/60 mb-6" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
            At ScamHelp, complaint support begins with a thorough evaluation of your case. Our experienced team carefully examines all aspects of your situation, gathering necessary evidence and documentation to build a strong foundation for your claim.
          </p>
          <ul class="space-y-3 mb-8">
            <li class="text-[#0a0a0f]/55" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7">
              <span class="text-[#0a0a0f] font-semibold">Expertise:</span> Our case managers have experience preparing complaints for banks, card issuers and ombudsman services.
            </li>
            <li class="text-[#0a0a0f]/55" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7">
              <span class="text-[#0a0a0f] font-semibold">Comprehensive Services:</span> Investigation, documentation and complaints handled in one place.
            </li>
            <li class="text-[#0a0a0f]/55" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7">
              <span class="text-[#0a0a0f] font-semibold">Personalized Approach:</span> Each case is unique, and we tailor our strategies to meet your specific needs and circumstances.
            </li>
            <li class="text-[#0a0a0f]/55" style="font-family:'Inter',sans-serif;font-size:14px;line-height:1.7">
              <span class="text-[#0a0a0f] font-semibold">Clear communication:</span> we keep you informed of every response we receive.
            </li>
          </ul>
          <a href="#consultation" class="inline-flex items-center gap-2 px-6 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600">
            Free Consultation
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>


    <!-- ─── CTA ─── -->
    <section class="py-12 md:py-16 px-6 relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#9ACF84]/3 rounded-full blur-[180px] pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl mx-auto text-center">
        <h2 class="text-white mb-6 reveal" style="font-family:'Montserrat',sans-serif;font-size:clamp(24px,3.5vw,38px);font-weight:600;line-height:1.2">
          Need help with <span class="text-[#9ACF84]">a complaint?</span>
        </h2>
        <p class="text-white/40 mb-8 reveal" style="font-family:'Inter',sans-serif;font-size:15px;line-height:1.8">
          Contact us for a free, confidential consultation. We'll review your case and tell you honestly which options may apply.
        </p>
        <div class="reveal">
          <a href={url('/contact-us/')} class="inline-flex items-center gap-2 px-7 py-3.5 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors btn-scale" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600">
            Contact Us
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>


    <!-- ─── FAQ ─── -->
    <section class="py-12 md:py-16 px-6 bg-white relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-[#9ACF84]/5 rounded-full blur-[160px] pointer-events-none"></div>
      <div class="relative z-10 max-w-4xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">FAQ</span>
          <h2 class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
            Frequently Asked <span class="text-[#9ACF84]">Questions</span>
          </h2>
        </div>
        <div class="space-y-2">
          {faqs.map((faq, i) => (
            <div class={`faq-item reveal delay-${Math.min(i + 1, 5)} border border-[#e8e8e8] rounded-2xl overflow-hidden transition-all duration-300`}>
              <button class="faq-trigger w-full flex items-center justify-between gap-4 px-6 py-5 text-left hover:bg-[#f8f8f8] transition-colors duration-200" type="button" aria-expanded="false">
                <span class="text-[#0a0a0f]" style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;line-height:1.4">{faq.question}</span>
                <span class="faq-icon flex-shrink-0 w-7 h-7 rounded-full bg-[#f0f0f0] flex items-center justify-center transition-all duration-300">
                  <svg class="w-3.5 h-3.5 text-[#555] transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>
              <div class="faq-body" style="max-height:0;overflow:hidden;transition:max-height 0.35s ease, padding 0.35s ease;">
                <p class="px-6 pb-5 text-[#777]" style="font-size:14px;line-height:1.75">
                  {faq.answer.endsWith(FEES_REF)
                    ? <>{faq.answer.slice(0, -FEES_REF.length)}See <a href={url('/fees/')} class="text-[#6BA055] underline underline-offset-2 hover:text-[#9ACF84] transition-colors">Our Fees</a>.</>
                    : faq.answer}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>


    <ConsultationSection />
  </main>
  <Footer />
</Layout>


<script>
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item   = trigger.closest('.faq-item') as HTMLElement;
      const body   = item.querySelector('.faq-body')   as HTMLElement;
      const icon   = item.querySelector('.faq-icon')   as HTMLElement;
      const svg    = icon.querySelector('svg')          as SVGElement;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.faq-item').forEach((other) => {
        if (other !== item) {
          (other.querySelector('.faq-body') as HTMLElement).style.maxHeight = '0';
          other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
          (other.querySelector('.faq-icon') as HTMLElement).style.background = '#f0f0f0';
          (other.querySelector('.faq-icon svg') as SVGElement)?.style.setProperty('transform', 'rotate(0deg)');
          (other.querySelector('.faq-icon svg') as SVGElement)?.style.setProperty('color', '#555');
          (other as HTMLElement).style.borderColor = '#e8e8e8';
        }
      });

      if (isOpen) {
        body.style.maxHeight = '0';
        trigger.setAttribute('aria-expanded', 'false');
        icon.style.background = '#f0f0f0';
        svg.style.transform = 'rotate(0deg)';
        svg.style.color = '#555';
        item.style.borderColor = '#e8e8e8';
      } else {
        body.style.maxHeight = body.scrollHeight + 'px';
        trigger.setAttribute('aria-expanded', 'true');
        icon.style.background = '#9ACF84';
        svg.style.transform = 'rotate(180deg)';
        svg.style.color = '#0a0a0f';
        item.style.borderColor = 'rgba(154,207,132,0.4)';
      }
    });
  });
</script>
