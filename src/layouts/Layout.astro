---
import '../styles/index.css';
import CookieConsent from '../components/CookieConsent.astro';
import { BASE, IS_PRODUCTION, SITE_URL, GTM_ID, url, abs } from '../lib/site';

export interface Props {
  /** Unique page title, max 60 chars, format "Page topic, ScamHelp". */
  title: string;
  /** Unique meta description, 140 to 160 chars. */
  description: string;
  /** Force noindex (e.g. 404). Staging builds are always noindex. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (e.g. Article). */
  schema?: object[];
}

const { title, description, noindex = false, ogType = 'website', schema = [] } = Astro.props;

// Canonical / og:url always point to the production domain.
let path = Astro.url.pathname;
if (BASE && path.startsWith(BASE)) path = path.slice(BASE.length) || '/';
if (!path.endsWith('/') && !/\.[a-z0-9]+$/i.test(path)) path += '/';
const canonical = abs(path);

const robots = IS_PRODUCTION && !noindex ? 'index, follow' : 'noindex, nofollow';
const ogImage = abs('/og-image.png');

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ScamHelp",
  "legalName": "Transparent Business Solutions B.V.",
  "url": `${SITE_URL}/`,
  "logo": `${SITE_URL}/logo-full.svg`,
  "email": "support@scamhelp.net",
  "telephone": "+31707013260",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kalvermarkt 53",
    "postalCode": "2511 CB",
    "addressLocality": "The Hague",
    "addressCountry": "NL"
  },
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "KvK",
    "value": "78091624"
  },
  "sameAs": []
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Consent Mode v2: everything except strictly necessary storage is denied by default -->
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      window.__shGtmId = gtmId;
      window.__shLoadGtm = function () {
        if (!gtmId || window.__shGtmLoaded) return;
        window.__shGtmLoaded = true;
        dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        document.head.appendChild(s);
      };
      try {
        var stored = JSON.parse(localStorage.getItem('sh_consent') || 'null');
        if (stored && stored.v === 1) {
          gtag('consent', 'update', {
            analytics_storage: stored.analytics ? 'granted' : 'denied',
            ad_storage: stored.ads ? 'granted' : 'denied',
            ad_user_data: stored.ads ? 'granted' : 'denied',
            ad_personalization: stored.ads ? 'granted' : 'denied'
          });
          if (stored.analytics || stored.ads) window.__shLoadGtm();
        }
      } catch (e) {}
    </script>

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Transparent Business Solutions B.V." />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ScamHelp logo" />
    <meta property="og:site_name" content="ScamHelp" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={url('/logo_simple.svg')} />
    <link rel="apple-touch-icon" href={url('/logo_simple.svg')} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />

    <CookieConsent />

    <!-- Global scroll reveal observer -->
    <script>
      const reveals = document.querySelectorAll('.reveal');

      // Instantly show elements already in viewport on page load (no animation flicker)
      reveals.forEach((el) => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          el.classList.add('visible');
        }
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px 50px 0px' }
      );
      reveals.forEach((el) => {
        if (!el.classList.contains('visible')) {
          revealObserver.observe(el);
        }
      });
    </script>

    <script>
      import Lenis from 'lenis';

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
        autoToggle: false,
        prevent: (node: HTMLElement) => {
          if (node.tagName !== 'TEXTAREA') return false;
          return node.scrollHeight > node.clientHeight;
        },
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // Mobile-only expandable text blocks (long descriptions)
      function setupExpandableText() {
        document.querySelectorAll('.text-expandable').forEach((el) => {
          if ((el as any)._textExpandableSetup) return;
          if (window.innerWidth >= 768) return;
          const limit = parseInt(el.getAttribute('data-truncate') || '200', 10);
          const fullText = (el.textContent || '').replace(/\s+/g, ' ').trim();
          if (fullText.length <= limit) return;

          (el as any)._textExpandableSetup = true;
          const originalHTML = el.innerHTML;
          const truncated = fullText.slice(0, limit).trim() + '...';
          const stylePref = (el.querySelector('p') as HTMLElement)?.getAttribute('style') || '';
          const classPref = (el.querySelector('p') as HTMLElement)?.getAttribute('class') || '';

          function showCollapsed() {
            el.innerHTML =
              `<p class="${classPref}" style="${stylePref}">${truncated} <button type="button" class="text-toggle-btn">See more</button></p>`;
            el.querySelector('.text-toggle-btn')?.addEventListener('click', (e) => {
              e.stopPropagation();
              showExpanded();
            });
          }
          function showExpanded() {
            el.innerHTML =
              originalHTML +
              `<p class="${classPref}" style="${stylePref};margin-top:0.5rem"><button type="button" class="text-toggle-btn">See less</button></p>`;
            el.querySelector('.text-toggle-btn')?.addEventListener('click', (e) => {
              e.stopPropagation();
              showCollapsed();
            });
          }
          showCollapsed();
        });
      }
      setupExpandableText();

      // Mobile-only expandable cards
      function setupExpandableCards() {
        document.querySelectorAll('.card-expandable').forEach((card) => {
          if ((card as any)._cardExpandableSetup) return;
          (card as any)._cardExpandableSetup = true;
          // Inject chevron arrow into the title row (first flex direct child)
          if (!card.querySelector('.card-toggle-chevron')) {
            const titleRow = card.querySelector(':scope > .flex') as HTMLElement | null;
            if (titleRow) {
              const chevron = document.createElement('div');
              chevron.className = 'card-toggle-chevron';
              chevron.innerHTML = '<svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>';
              titleRow.appendChild(chevron);
            }
          }
          card.addEventListener('click', (e) => {
            if (window.innerWidth >= 768) return;
            const target = e.target as HTMLElement;
            if (target.closest('a, button, input, select, textarea')) return;
            const desc = card.querySelector('.card-desc') as HTMLElement | null;
            const isExpanding = !card.classList.contains('expanded');
            if (desc) {
              if (isExpanding) {
                desc.style.maxHeight = desc.scrollHeight + 'px';
              } else {
                desc.style.maxHeight = desc.scrollHeight + 'px';
                desc.offsetHeight; // force reflow
                desc.style.maxHeight = '';
              }
            }
            card.classList.toggle('expanded');
          });
        });
      }
      setupExpandableCards();

      // Handle anchor links with Lenis smooth scroll + offset for navbar
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = (anchor as HTMLAnchorElement).getAttribute('href');
          if (!href || href === '#') return;
          const target = document.querySelector(href);
          if (target) {
            e.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: -240 });
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── Mobile expandable text ── */
  .text-toggle-btn {
    display: inline;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: #9ACF84;
    font-weight: 700;
    font-family: 'Montserrat', sans-serif;
    font-size: inherit;
    line-height: inherit;
  }
  .text-toggle-btn:hover {
    text-decoration: underline;
  }

  /* ── Mobile expandable cards ── */
  .card-toggle-chevron { display: none; }
  @media (max-width: 767px) {
    .card-expandable {
      cursor: pointer;
      padding: 0.75rem !important;
    }
    .card-expandable > .flex {
      margin-bottom: 0 !important;
    }
    .card-expandable .card-desc {
      max-height: 0;
      margin-top: 0;
      overflow: hidden;
      transition: max-height 0.6s cubic-bezier(0.25, 0.1, 0.25, 1), margin-top 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .card-expandable.expanded .card-desc {
      margin-top: 0.75rem;
    }
    .card-expandable .card-toggle-chevron {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
      flex-shrink: 0;
      width: 24px;
      height: 24px;
      color: #9ACF84;
      transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    .card-expandable.expanded .card-toggle-chevron {
      transform: rotate(180deg);
    }
  }

  /* ── Scroll reveal ── */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.from-left  { transform: translateX(-40px); }
  .reveal.from-right { transform: translateX(40px);  }
  .reveal.from-scale { transform: scale(0.94);       }
  .reveal.visible {
    opacity: 1;
    transform: translate(0) scale(1);
  }

  /* Staggered children */
  .reveal.delay-1 { transition-delay: 0.1s; }
  .reveal.delay-2 { transition-delay: 0.2s; }
  .reveal.delay-3 { transition-delay: 0.3s; }
  .reveal.delay-4 { transition-delay: 0.4s; }
  .reveal.delay-5 { transition-delay: 0.5s; }
  .reveal.delay-6 { transition-delay: 0.6s; }

  /* ── CSS Keyframe Animations ── */
  @keyframes float-y {
    0%, 100% { transform: translateY(-6px); }
    50%       { transform: translateY(6px);  }
  }
  @keyframes float-y-sm {
    0%, 100% { transform: translateY(-4px); }
    50%       { transform: translateY(4px);  }
  }
  @keyframes float-card-1 {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(3px, -4px); }
    50%  { transform: translate(-2px, 2px); }
    75%  { transform: translate(2px, 4px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes float-card-2 {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(-2px, 3px); }
    50%  { transform: translate(4px, -2px); }
    75%  { transform: translate(-3px, -3px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes float-card-3 {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(2px, 2px); }
    50%  { transform: translate(-3px, -4px); }
    75%  { transform: translate(4px, -1px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }
  @keyframes pulse-ring {
    0%, 100% { transform: scale(1);    opacity: 0.3; }
    50%       { transform: scale(1.03); opacity: 0.6; }
  }
  @keyframes marquee {
    from { transform: translateX(0);   }
    to   { transform: translateX(-50%); }
  }
  @keyframes bounce-y {
    0%, 100% { transform: translateY(0);  }
    50%       { transform: translateY(8px); }
  }
  @keyframes orb-float {
    0%, 100% { transform: translateY(-20px); }
    50%       { transform: translateY(20px);  }
  }
  @keyframes orb-float-rev {
    0%, 100% { transform: translateY(15px);  }
    50%       { transform: translateY(-15px); }
  }
  @keyframes dot-pulse {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50%       { opacity: 0.8; transform: scale(1.2); }
  }
  @keyframes draw-line {
    0%   { stroke-dashoffset: 400; opacity: 0.8; }
    50%  { stroke-dashoffset: 0;   opacity: 0.8; }
    100% { stroke-dashoffset: -400; opacity: 0;  }
  }
  @keyframes icon-enter {
    from { opacity: 0; transform: scale(0); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes icon-float {
    0%, 100% { transform: translateY(-6px) rotate(5deg);  }
    50%       { transform: translateY(6px)  rotate(-5deg); }
  }

  .animate-float      { animation: float-y 5s ease-in-out infinite; }
  .animate-float-sm   { animation: float-y-sm 5s ease-in-out infinite; }
  .animate-spin-slow  { animation: spin-slow 60s linear infinite; }
  .animate-pulse-ring { animation: pulse-ring 4s ease-in-out infinite; }
  .animate-marquee    { animation: marquee 25s linear infinite; }
  .animate-bounce-y   { animation: bounce-y 2s ease-in-out infinite; }
  .animate-orb        { animation: orb-float 8s ease-in-out infinite; }
  .animate-orb-rev    { animation: orb-float-rev 10s ease-in-out infinite; }

  /* ── Button hover effects ── */
  .btn-scale {
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .btn-scale:hover  { transform: scale(1.02); }
  .btn-scale:active { transform: scale(0.98); }

  /* ── Navbar scroll transition ── */
  #navbar {
    background-color: rgba(10, 10, 15, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
  }
  #navbar.scrolled {
    background-color: rgba(10, 10, 15, 0.35);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
  }

  /* ── Mobile menu ── */
  #mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, opacity 0.25s ease;
    opacity: 0;
  }
  #mobile-menu.open {
    max-height: 600px;
    opacity: 1;
  }

  /* ── Services dropdown ── */
  .nav-dropdown { position: relative; }
  .nav-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    width: 208px;
    background: #161620;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    padding: 6px;
    backdrop-filter: blur(12px);
    z-index: 100;
  }
  .nav-dropdown:hover .nav-dropdown-menu { display: block; }

  /* ── Testimonials ── */
  .testimonial-card {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* ── Form radio cards ── */
  .radio-card input[type="radio"] { position: absolute; opacity: 0; width: 0; height: 0; }
  .radio-card.selected {
    border-color: rgba(154, 207, 132, 0.4);
    background-color: rgba(154, 207, 132, 0.08);
    color: #9ACF84;
  }
  .radio-dot {
    width: 12px; height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.25);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .radio-card.selected .radio-dot {
    border-color: #9ACF84;
  }
  .radio-dot-inner {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #9ACF84;
    display: none;
  }
  .radio-card.selected .radio-dot-inner { display: block; }
</style>
