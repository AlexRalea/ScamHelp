---
import ImpersonationWarning from './ImpersonationWarning.astro';
import { url, KVK_URL, JUSTIS_URL, PHONES } from '../lib/site';

const legalLinks = [
  { label: "Company Registration", href: KVK_URL, external: true },
  { label: "Our Fees", href: url('/fees/') },
  { label: "Refund Policy", href: url('/refund-policy/') },
  { label: "Terms and Conditions", href: url('/terms-and-conditions/') },
  { label: "Privacy Policy", href: url('/privacy-policy/') },
  { label: "Cookie Policy", href: url('/cookie-policy/') },
  { label: "Data Protection Addendum", href: url('/data-protection-addendum/') },
];
---

<ImpersonationWarning />

<footer class="relative pt-16 pb-8 bg-[#0a0a0f] overflow-hidden">

  <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-[#9ACF84]/2 rounded-full blur-[200px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Main grid: company | legal | contact -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">

      <!-- Company info -->
      <div>
        <!-- Logo -->
        <div class="mb-5">
          <img src={url('/logo-full.svg')} alt="ScamHelp logo" class="h-10 w-auto" />
        </div>

        <p class="text-white/40" style="font-size:12px;line-height:1.75">
          ScamHelp is a registered trade name of Transparent Business Solutions B.V., a private
          investigation agency licensed by the Dutch Ministry of Justice and Security
          (<a href={JUSTIS_URL} target="_blank" rel="noopener noreferrer" class="text-[#9ACF84] hover:underline">licence POB 07373</a>),
          registered with the Netherlands Chamber of Commerce under
          <a href={KVK_URL} target="_blank" rel="noopener noreferrer" class="text-[#9ACF84] hover:underline">KvK 78091624</a>,
          Kalvermarkt 53, 2511 CB The Hague, Netherlands. Free consultation; fees agreed in writing
          before any work begins. Outcomes vary by case and are not guaranteed. ScamHelp does not
          provide legal services, financial advice or investments, and never asks for "release fees"
          or payments to unlock recovered funds. Note for UK residents: we do not assist with
          complaints about mis-sold investment products regulated by the UK PRA or FCA.
        </p>
      </div>

      <!-- Legal Documents -->
      <div>
        <h4 class="text-white mb-1" style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700">
          Legal Documents
        </h4>
        <div class="w-10 h-0.5 bg-[#9ACF84] mb-5"></div>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="text-white/50 hover:text-[#9ACF84] transition-colors duration-200 underline underline-offset-2"
                style="font-size:13px"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <button
              type="button"
              data-cookie-settings
              class="text-white/50 hover:text-[#9ACF84] transition-colors duration-200 underline underline-offset-2 cursor-pointer"
              style="font-size:13px"
            >
              Cookie settings
            </button>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-white mb-1" style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700">
          Contact Info
        </h4>
        <div class="w-10 h-0.5 bg-[#9ACF84] mb-5"></div>
        <div class="space-y-4">
          <!-- Address -->
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-white/45" style="font-size:13px;line-height:1.6">Kalvermarkt 53, 2511 CB<br/>The Hague, Netherlands</span>
          </div>
          <!-- Email -->
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:support@scamhelp.net" class="text-white/45 hover:text-[#9ACF84] transition-colors" style="font-size:13px">support@scamhelp.net</a>
          </div>
          <!-- Phones: one per line with country label -->
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <ul class="space-y-1">
              {PHONES.map((p) => (
                <li class="text-white/45" style="font-size:13px">
                  <span class="text-white/30">{p.country}:</span>{" "}
                  <a href={`tel:${p.tel}`} class="hover:text-[#9ACF84] transition-colors">{p.display}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-white/5 text-center">
      <p class="text-white/25" style="font-size:12px">
        &copy; 2026 Transparent Business Solutions B.V. (ScamHelp). All rights reserved.
      </p>
    </div>

  </div>
</footer>
