---
import { url } from '../lib/site';
const { BASE_URL } = import.meta.env;

type Reason = {
  title: string;
  description: string;
  link?: { before: string; text: string; href: string; after: string };
  iconPath: string;
};

// Cards 1-3: approved "Why us?" card texts from the About Us page (Part 2).
const reasons: Reason[] = [
  {
    title: "Licensed and verifiable",
    description: "We are a licensed Dutch private investigation agency. Our licence and company registration can be checked in public registers.",
    // BadgeCheck icon
    iconPath: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  },
  {
    title: "Clear fees, in writing",
    description: "Your first consultation is free. Any fees are set out in a written agreement before work begins.",
    link: { before: " See ", text: "Our Fees", href: url('/fees/'), after: "." },
    // Document icon
    iconPath: "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  },
  {
    title: "Honest assessments",
    description: "If we do not believe we can help, we tell you so at the consultation stage, and you pay nothing.",
    // Chat icon
    iconPath: "M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z",
  },
  {
    title: "Diverse Scam Expertise",
    description: "We specialize in addressing various scams, from intricate fraud schemes to cybercrime.",
    // ShieldCheck icon
    iconPath: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  },
];
---

<section class="py-12 md:py-14 relative overflow-hidden">
  <!-- Video background -->
  <video
    class="absolute inset-0 w-full h-full object-cover"
    src={`${BASE_URL}/why_us_section_video.mp4`}
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  ></video>
  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-[#0a0a0f]/80"></div>


  <!-- Marquee text background removed — moved to ScamTypesSection -->
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Heading -->
    <div class="reveal text-center mb-16">
      <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">
        Why Choose Us
      </span>
      <h2 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
        Why Choose Us For{" "}
        <span class="text-[#9ACF84]">Scam Victim Help?</span>
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid md:grid-cols-2 gap-4">
      {reasons.map((reason, i) => (
        <div class={`reveal delay-${i + 1} why-card group p-4 md:p-7 rounded-xl border border-white/5 bg-white/[0.04] backdrop-blur-md relative overflow-hidden`}>
          <div class="why-card-overlay absolute inset-0 bg-gradient-to-br from-[#9ACF84]/0 to-[#9ACF84]/0 pointer-events-none"></div>
          <div class="relative z-10">
            <div class="flex items-center gap-4 mb-3">
              <div class="why-card-icon flex-shrink-0 w-12 h-12 rounded-xl bg-[#9ACF84]/8 flex items-center justify-center">
                <svg class="w-5 h-5 text-[#9ACF84]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d={reason.iconPath} />
                </svg>
              </div>
              <h3 class="text-white" style="font-family:'Montserrat',sans-serif;font-size:16px;font-weight:600">
                {reason.title}
              </h3>
            </div>
            <p class="text-white/40" style="font-size:14px;line-height:1.65">
              {reason.description}{reason.link && (
                <>{reason.link.before}<a href={reason.link.href} class="text-[#9ACF84] hover:underline">{reason.link.text}</a>{reason.link.after}</>
              )}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Process text + CTA -->
    <div id="why-cta-box" class="reveal delay-5 mt-12 p-8 rounded-xl bg-white/[0.04] backdrop-blur-md border border-white/5 cursor-pointer lg:cursor-default">
      <p id="why-cta-text" class="text-white/35 mb-6" style="font-size:14px;line-height:1.85">
        ScamHelp is a registered trade name of Transparent Business Solutions B.V., a private
        investigation agency licensed by the Dutch Ministry of Justice and Security. We assess every
        case honestly before any fees are agreed, set out our fees in writing, and keep clients
        informed at every stage.
      </p>
      <a
        href={url('/contact-us/')}
        class="btn-scale inline-flex items-center gap-2 px-7 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors duration-200"
        style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600"
      >
        Contact Us
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .why-card,
  .why-card-overlay,
  .why-card-icon {
    transition: background-color 1s ease-out, border-color 1s ease-out, background-image 1s ease-out, transform 1s ease-out;
  }
  .why-card:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border-color: rgba(154, 207, 132, 0.15);
    transform: translateY(-3px);
  }
  .why-card:hover .why-card-overlay {
    background-image: linear-gradient(to bottom right, rgba(154, 207, 132, 0.05), transparent);
  }
  .why-card:hover .why-card-icon {
    background-color: rgba(154, 207, 132, 0.18);
  }
</style>

<script>
  const box  = document.getElementById('why-cta-box');
  const para = document.getElementById('why-cta-text');
  if (!box || !para) throw new Error();

  const fullText = para.textContent?.trim() ?? '';
  const words    = fullText.split(/\s+/);
  const LIMIT    = 30;
  let expanded   = false;

  function isMobile() { return window.innerWidth < 1024; }

  function truncate() {
    para.innerHTML =
      words.slice(0, LIMIT).join(' ') +
      '<span style="color:rgba(255,255,255,0.35)"> ...</span>';
  }

  para.style.overflow   = 'hidden';
  para.style.transition = 'max-height 0.45s ease';

  function init() {
    if (!isMobile()) {
      para.textContent  = fullText;
      para.style.maxHeight = 'none';
      return;
    }
    truncate();
    requestAnimationFrame(() => {
      para.style.maxHeight = para.scrollHeight + 'px';
    });
  }

  init();

  box.addEventListener('click', (e) => {
    if (!isMobile() || expanded) return;
    if ((e.target as HTMLElement).closest('a')) return;
    expanded = true;
    para.textContent = fullText;
    para.style.maxHeight = para.scrollHeight + 'px';
  });

  window.addEventListener('resize', () => {
    if (!isMobile()) {
      para.textContent     = fullText;
      para.style.maxHeight = 'none';
      expanded = false;
    } else if (!expanded) {
      truncate();
      para.style.maxHeight = para.scrollHeight + 'px';
    }
  });
</script>
