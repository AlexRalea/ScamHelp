---
import { url } from '../lib/site';
---

<section id="about" class="pt-12 pb-24 md:pt-14 md:pb-28 bg-white relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[#9ACF84]/5 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-14 items-center">

      <!-- Image + Stats overlay -->
      <div class="reveal from-left relative about-img-col order-2 lg:order-1" style="perspective:1200px;">
        <div class="rounded-xl overflow-hidden about-img-frame" style="transform:rotateY(10deg);box-shadow:-24px 16px 60px rgba(0,0,0,0.18), -8px 6px 20px rgba(0,0,0,0.12);">
          <img
            src="https://images.unsplash.com/photo-1769740333462-9a63bfa914bc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxwcm9mZXNzaW9uYWwlMjB0ZWFtJTIwY29ycG9yYXRlJTIwb2ZmaWNlfGVufDF8fHx8MTc3MjQ0MDc1MHww&ixlib=rb-4.1.0&q=80&w=1080"
            alt="Professional team in an office"
            class="w-full h-[480px] object-cover"
            loading="lazy"
          />
        </div>

        <!-- Stats overlay (floating card) -->
        <div class="absolute -bottom-8 left-6 z-10 floating-card-wrapper" style="perspective:800px;transform-style:preserve-3d;max-width:320px;">
          <div class="floating-card-rotate" style="transform:rotateY(10deg);transition:transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);">
            <div>
              <div class="reveal delay-3 bg-white rounded-xl border border-[#e8e8e8] p-5 grid grid-cols-2 gap-6 text-center" style="box-shadow:0 8px 30px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);">
                <div>
                  <div
                    class="counter text-[#6BA055]"
                    data-target="750"
                    data-suffix="+"
                    style="font-family:'Montserrat',sans-serif;font-size:40px;font-weight:700"
                  >0+</div>
                  <div class="text-[#999]" style="font-family:'Montserrat',sans-serif;font-size:12px">
                    Clients helped
                  </div>
                </div>
                <div>
                  <div
                    class="counter text-[#6BA055]"
                    data-target="60"
                    data-suffix="+"
                    style="font-family:'Montserrat',sans-serif;font-size:40px;font-weight:700"
                  >0+</div>
                  <div class="text-[#999]" style="font-family:'Montserrat',sans-serif;font-size:12px">
                    Countries we have active cases in
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Text column -->
      <div class="reveal from-right delay-1 order-1 lg:order-2">
        <span class="text-[#9ACF84] uppercase tracking-[0.2em] mb-5 block" style="font-family:'Montserrat',sans-serif;font-size:11px;font-weight:600">
          Who we are
        </span>
        <h2 class="text-[#0a0a0f] mb-6" style="font-family:'Montserrat',sans-serif;font-size:clamp(26px,3.5vw,42px);font-weight:600;line-height:1.15">
          A licensed private investigation agency{" "}
          <span class="text-[#6BA055]">specialising in online fraud</span>
        </h2>
        <p class="text-[#555] mb-8" style="font-size:15px;line-height:1.85">
          ScamHelp is a registered trade name of Transparent Business Solutions B.V., a private
          investigation agency based in The Hague and licensed by the Dutch Ministry of Justice and
          Security (licence POB 07373, KvK 78091624). Our team of fraud investigators, financial
          forensic analysts and case managers works on online investment, cryptocurrency and banking
          fraud. We help clients worldwide prepare disputes and complaints against fraudulent merchants
          and platforms, and work with independent investigators and specialists where a case requires it.
        </p>

        <a
          href={url('/about/')}
          class="btn-scale inline-flex items-center gap-2 px-7 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-xl hover:bg-[#8BC275] transition-colors duration-200"
          style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600"
        >
          Learn more
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  // Animated counters with IntersectionObserver
  function animateCounter(el: Element) {
    const target   = parseInt(el.getAttribute('data-target') || '0', 10);
    const suffix   = el.getAttribute('data-suffix') || '';
    const duration = 2000;
    const start    = Date.now();

    const tick = () => {
      const elapsed  = Date.now() - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased    = 1 - Math.pow(1 - progress, 3);
      el.textContent = `${Math.floor(eased * target)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll('.counter').forEach((el) => counterObserver.observe(el));
</script>

<style>
  .floating-card-wrapper:hover .floating-card-rotate {
    transform: rotateY(0deg) !important;
  }

  @media (max-width: 1079px) {
    .about-img-col { perspective: none !important; }
    .about-img-frame { transform: none !important; box-shadow: 0 8px 30px rgba(0,0,0,0.12) !important; }
    .about-img-col .floating-card-rotate { transform: none !important; }
  }
</style>
